# Copy to .env and replace every placeholder with unique secrets.
DB_DATABASE=helpdesk_db
DB_USERNAME=helpdesk
DB_PASSWORD=replace-with-a-long-random-secret
DB_ROOT_PASSWORD=replace-with-a-different-long-random-secret

# Local defaults bind only to loopback. For direct public access, configure
# TLS/reverse proxy first and deliberately set APP_BIND_ADDRESS.
APP_BIND_ADDRESS=127.0.0.1
APP_FORWARD_PORT=8082
